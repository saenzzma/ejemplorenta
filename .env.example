# Solo una BD nueva de Talsory expresamente autorizada.
SQL_SERVER=sql-talsory-NOMBRE-NUEVO.database.windows.net
SQL_DATABASE=talsory
SQL_USER=talsory_app
SQL_PASSWORD=REEMPLAZAR_FUERA_DEL_REPOSITORIO
JWT_SECRET=GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
INTERNAL_KEY=GENERAR_OTRO_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
REVIEWER_HASH=SAL_ALEATORIA:HASH_SCRYPT_HEXADECIMAL_DE_64_BYTES
PORT=8080
# src/demo.js arranca Go y el simulador internos. Para roles separados:
ROUTES_URL=http://routes-interno:8080
INARI_URL=http://simulador-interno:8080
# Solo para la variante distribuida, no desplegada en la simulación gratuita:
SERVICE_BUS_CONNECTION=CONFIGURAR_COMO_SECRETO_DE_AZURE
SERVICE_BUS_QUEUE=loans
